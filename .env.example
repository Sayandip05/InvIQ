# ─── Smart Inventory Assistant ─── Environment Config Template ───
#
# Exactly TWO environments are supported:
#   1. DEVELOPMENT (Local Docker PostgreSQL & Local Docker Redis)
#   2. PRODUCTION  (Supabase PostgreSQL & Upstash Redis Cloud)
#
# ══════════════════════════════════════════════════════════════════════════
# 1. CORE APPLICATION SETTINGS
# ══════════════════════════════════════════════════════════════════════════
ENVIRONMENT=development
PROJECT_NAME="Smart Inventory Assistant"

# ══════════════════════════════════════════════════════════════════════════
# 2. DATABASE CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════
# DEVELOPMENT (Local Docker PostgreSQL):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inviq_dev
# PRODUCTION (Supabase PostgreSQL):
# Transaction pooler (for FastAPI / Celery runtime — port 6543):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct session pooler (for Alembic migrations / DDL scripts — port 5432):
# DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Connection Pooling (Recommended: 5-10 per worker process to prevent connection exhaustion)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ══════════════════════════════════════════════════════════════════════════
# 3. REDIS & CELERY BROKER CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════
# DEVELOPMENT (Local Docker Redis):
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
# PRODUCTION (Upstash Cloud Redis):
# REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:6379/0

# Optional Upstash REST credentials (if using REST fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ══════════════════════════════════════════════════════════════════════════
# 4. FRONTEND & CORS
# ══════════════════════════════════════════════════════════════════════════
# DEVELOPMENT:
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
# PRODUCTION:
# FRONTEND_URL=https://inviq.yourdomain.com
# CORS_ORIGINS=https://inviq.yourdomain.com

# ══════════════════════════════════════════════════════════════════════════
# 5. AI / LLM (Groq)
# ══════════════════════════════════════════════════════════════════════════
# Get your API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ══════════════════════════════════════════════════════════════════════════
# 6. VECTOR STORE (Qdrant Cloud)
# ══════════════════════════════════════════════════════════════════════════
# DEVELOPMENT (can be false for local testing):
QDRANT_ENABLED=false
# PRODUCTION (Qdrant Cloud):
# QDRANT_ENABLED=true
# QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=chat_memory

# ══════════════════════════════════════════════════════════════════════════
# 7. SECURITY & AUTHENTICATION
# ══════════════════════════════════════════════════════════════════════════
# Generate a 32+ character random secret: openssl rand -hex 32
SECRET_KEY=dev-insecure-secret-key-32-chars-minimum-length
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Login Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ══════════════════════════════════════════════════════════════════════════
# 8. ADMIN SEED ACCOUNTS
# ══════════════════════════════════════════════════════════════════════════
ADMIN_EMAIL=admin@inventory.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPassword123!
ADMIN_FULL_NAME=System Administrator

# ══════════════════════════════════════════════════════════════════════════
# 9. RATE LIMITING
# ══════════════════════════════════════════════════════════════════════════
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=5/minute

# ══════════════════════════════════════════════════════════════════════════
# 10. SMTP (Email Notifications)
# ══════════════════════════════════════════════════════════════════════════
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="InvIQ Smart Inventory"

# ══════════════════════════════════════════════════════════════════════════
# 11. AZURE BLOB STORAGE (Invoices, Reports & Imports)
# ══════════════════════════════════════════════════════════════════════════
AZURE_STORAGE_CONTAINER_NAME=inviq-documents
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=

# ══════════════════════════════════════════════════════════════════════════
# 12. EXTERNAL APIs
# ══════════════════════════════════════════════════════════════════════════
GOOGLE_OAUTH_VERIFY_URL=https://www.googleapis.com/oauth2/v3/userinfo