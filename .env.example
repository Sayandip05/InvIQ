# ═══════════════════════════════════════════════════════════════════════════
# InvIQ Smart Inventory Assistant - Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════
#
# Exactly TWO environments are supported:
#   1. DEVELOPMENT (Local machine testing / Docker PostgreSQL & Redis)
#   2. PRODUCTION  (Cloud: Azure App Service + Supabase Postgres + Upstash Redis)
#
# Copy this file to .env and replace placeholder values with your credentials:
#   cp .env.example .env
#

# ── 1. Application ─────────────────────────────────────────────────────────
ENVIRONMENT=development
PROJECT_NAME="Smart Inventory Assistant"

# ── 2. Database (PostgreSQL / Supabase) ────────────────────────────────────
# DEVELOPMENT (Local PostgreSQL):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inviq_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/inviq_dev

# PRODUCTION (Supabase PostgreSQL):
# Transaction pooler (for FastAPI / Celery runtime — port 6543):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct session pooler (for Alembic migrations / DDL scripts — port 5432):
# DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Connection Pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── 3. Frontend & CORS ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://localhost:5174

# ── 4. AI / LLM (Chatbot & Reasoning) ──────────────────────────────────────
# Get your API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ── 5. Gemini (Embeddings for Vector Memory) ───────────────────────────────
# Google AI Studio key: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── 6. LangSmith (AI Observability & Tracing) ──────────────────────────────
# LangSmith dashboard: https://smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=InvIQ
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── 7. Qdrant Cloud (Vector Store for Chat Memory & RAG) ───────────────────
QDRANT_ENABLED=true
QDRANT_URL=https://your-cluster-id.sa-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=chat_memory

# ── 8. Security & Tokens ───────────────────────────────────────────────────
# Generate a 32+ character random secret: openssl rand -hex 32
SECRET_KEY=dev-insecure-secret-key-32-chars-minimum-length
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 9. Login Lockout (Brute-Force Protection) ──────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ── 10. Admin Seed Account (Initial Setup) ─────────────────────────────────
ADMIN_EMAIL=admin@inviq.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPassword123!
ADMIN_FULL_NAME="System Administrator"

# ── 11. Redis & Celery Broker (Caching & Background Tasks) ────────────────
# Celery broker connection string:
REDIS_URL=redis://localhost:6379/0
# Upstash REST credentials (for distributed rate limiting & caching):
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
REDIS_ENABLED=true

# ── 12. Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=5/minute

# ── 13. SMTP (Email Verification & Alerts) ─────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="InvIQ Smart Inventory"

# ── 14. External APIs & OAuth ──────────────────────────────────────────────
GOOGLE_OAUTH_VERIFY_URL=https://www.googleapis.com/oauth2/v3/userinfo
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── 15. Custom APIs (Speech-to-Text / Audio) ───────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here

# ── 16. Azure Blob Storage (Invoices, Reports & Delivery Manifests) ────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=inviq-documents
AZURE_STORAGE_ACCOUNT_NAME=your_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_account_key